---
import type { Locale } from "@data/categories";

interface Props {
    lang: Locale;
    latestHref?: string;
    latestTitle?: string;
}

const {
    lang,
    latestHref = "#articles",
    latestTitle,
} = Astro.props;

const copy = {
    uz: {
        title: "Moliyaviy bilim, sodda tilda",
        lead: "Pul, kredit, inflyatsiya, bozorlar va kundalik iqtisodiy qarorlar haqida sodda tildagi maqolalar.",
        primaryCta: "Maqolalarni o‘qish",
        latestLabel: "So‘nggi maqola",
    },
    en: {
        title: "Finance, Explained Simply",
        lead: "Plain-language writing on money, credit, inflation, markets, and everyday economic decisions.",
        primaryCta: "Read articles",
        latestLabel: "Latest article",
    },
    ru: {
        title: "Финансы простым языком",
        lead: "Простые материалы о деньгах, кредитах, инфляции, рынках и повседневных экономических решениях.",
        primaryCta: "Читать статьи",
        latestLabel: "Новая статья",
    },
}[lang];
---

<section class="home-hero">
    <div class="container home-hero-grid">
        <div class="hero-copy">
            <h1 class="hero-title">{copy.title}</h1>
            <p class="hero-lede">{copy.lead}</p>

            <div class="hero-actions">
                <a class="button button-primary" href="#articles">
                    {copy.primaryCta}
                </a>
                {
                    latestTitle && (
                        <a class="button button-secondary" href={latestHref}>
                            <span>{copy.latestLabel}</span>
                            <strong>{latestTitle}</strong>
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</section>
