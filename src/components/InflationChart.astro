---
import type { Locale } from "@data/categories";

interface Props {
    lang?: Locale;
}

const { lang = "uz" } = Astro.props;

const translations: Record<
    Locale,
    {
        title: string;
        startYear: string;
        endYear: string;
        datasetLabel: string;
        tooltipLabel: string;
    }
> = {
    uz: {
        title: "O'zbekiston yillik inflyatsiyasi, 2016-2026",
        startYear: "Boshlanish yili",
        endYear: "Tugash yili",
        datasetLabel: "Yillik inflyatsiya",
        tooltipLabel: "Yillik inflyatsiya",
    },
    en: {
        title: "Uzbekistan annual inflation, 2016-2026",
        startYear: "Start year",
        endYear: "End year",
        datasetLabel: "Annual inflation",
        tooltipLabel: "Annual inflation",
    },
    ru: {
        title: "Годовая инфляция в Узбекистане, 2016-2026",
        startYear: "Начальный год",
        endYear: "Конечный год",
        datasetLabel: "Годовая инфляция",
        tooltipLabel: "Годовая инфляция",
    },
};

const strings = translations[lang];
---

<div
    class="inflation-chart chart-container card-vessel"
    data-inflation-chart
    data-strings={JSON.stringify(strings)}
>
    <p class="chart-eyebrow">{strings.title}</p>

    <div class="sliders inflation-chart-sliders">
        <div class="slider-group">
            <label>
                {strings.startYear} <span data-inflation-chart-from-value>2016</span>
            </label>
            <input
                type="range"
                data-inflation-chart-from
                min="2016"
                max="2025"
                step="1"
                value="2016"
            />
        </div>
        <div class="slider-group">
            <label>
                {strings.endYear} <span data-inflation-chart-to-value>2026</span>
            </label>
            <input
                type="range"
                data-inflation-chart-to
                min="2017"
                max="2026"
                step="1"
                value="2026"
            />
        </div>
    </div>

    <canvas data-inflation-chart-canvas height="260"></canvas>
</div>

<script>
    import Chart, { type ChartData, type TooltipItem } from "chart.js/auto";

    type InflationStrings = {
