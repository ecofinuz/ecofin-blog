        ["Sentabr 2025", 0.6, 8],
        ["Oktabr 2025", 0.6, 7.8],
        ["Noyabr 2025", 0.7, 7.5],
        ["Dekabr 2025", 0.9, 7.3],
        ["Yanvar 2026", 0.7, 7.2],
        ["Fevral 2026", 0.6, 7.3],
        ["Mart 2026", 0.6, 7.1],
        ["April 2026", 0.6, 7.0],
        ["May 2026", 0.2, 5.5],
    ];

    const getYear = (label: string): number => Number(label.split(" ")[1]);

    const charts = document.querySelectorAll<HTMLElement>(
        "[data-inflation-chart]",
    );

    charts.forEach((root) => {
        const strings = JSON.parse(root.dataset.strings!) as InflationStrings;
        const fromEl = root.querySelector<HTMLInputElement>(
            "[data-inflation-chart-from]",
        )!;
        const toEl = root.querySelector<HTMLInputElement>(
            "[data-inflation-chart-to]",
        )!;
        const fromValue = root.querySelector<HTMLElement>(
            "[data-inflation-chart-from-value]",
        )!;
        const toValue = root.querySelector<HTMLElement>(
            "[data-inflation-chart-to-value]",
        )!;
        const canvas = root.querySelector<HTMLCanvasElement>(
            "[data-inflation-chart-canvas]",
        )!;
        const getThemeColor = (name: string, fallback: string): string =>
            getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

        const getChartColors = () => ({
            line: getThemeColor("--line-compound", "#0f766e"),
            grid: getThemeColor("--chart-grid", "rgb(15 23 42 / 0.14)"),
            tick: getThemeColor("--chart-tick", "rgb(15 23 42 / 0.56)"),
            tooltipBg: getThemeColor("--chart-tooltip-bg", "#0f172a"),
            tooltipTitle: getThemeColor("--chart-tooltip-title", "#34d399"),
            tooltipBody: getThemeColor("--chart-tooltip-body", "#ffffff"),
        });

        const initialColors = getChartColors();

        const chartData: ChartData<"line", number[], string> = {
            labels: [],
            datasets: [
                {
                    label: strings.datasetLabel,
                    data: [],
                    borderColor: initialColors.line,
                    borderWidth: 1.5,
                    pointRadius: 1.5,
                    pointBackgroundColor: initialColors.line,
                    tension: 0.3,
                    fill: false,
                },
            ],
        };

        const chart: Chart<"line", number[], string> = new Chart(canvas, {
            type: "line",
            data: chartData,
            options: {
                responsive: true,
                animation: { duration: 250 },
                interaction: { mode: "index", intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: initialColors.tooltipBg,
                        titleColor: initialColors.tooltipTitle,
                        bodyColor: initialColors.tooltipBody,
                        padding: 12,
                        callbacks: {
                            title: (ctx) => ctx[0]?.label ?? "",
                            label: (ctx: TooltipItem<"line">) =>
                                `${strings.tooltipLabel}: ${ctx.parsed.y}%`,
                        },
                    },
                },
                scales: {
                    x: {
                        grid: { color: initialColors.grid },
                        ticks: {
                            color: initialColors.tick,
                            font: { size: 11 },
                            maxRotation: 45,
                            autoSkip: true,
                            maxTicksLimit: 14,
                        },
                    },
                    y: {
                        grid: { color: initialColors.grid },
                        ticks: {
                            color: initialColors.tick,
                            font: { size: 11 },
                            callback: (value) => `${value}%`,
                        },
                    },
                },
            },
        });

        function applyTheme(): void {
            const colors = getChartColors();
            const dataset = chart.data.datasets[0];
            if (dataset) {
                dataset.borderColor = colors.line;
                dataset.pointBackgroundColor = colors.line;
            }

            const options = chart.options as any;
            options.plugins.tooltip.backgroundColor = colors.tooltipBg;
            options.plugins.tooltip.titleColor = colors.tooltipTitle;
            options.plugins.tooltip.bodyColor = colors.tooltipBody;
            options.scales.x.grid.color = colors.grid;
            options.scales.x.ticks.color = colors.tick;
            options.scales.y.grid.color = colors.grid;
            options.scales.y.ticks.color = colors.tick;
            chart.update("none");
        }

        function update(): void {
            let fromYear = Number(fromEl.value);
            let toYear = Number(toEl.value);

            if (fromYear >= toYear) {
                if (document.activeElement === fromEl) {
                    toYear = fromYear + 1;
                    toEl.value = String(toYear);
                } else {
                    fromYear = toYear - 1;
                    fromEl.value = String(fromYear);
                }
            }

            fromValue.textContent = String(fromYear);
            toValue.textContent = String(toYear);

            const filtered = inflationData.filter((record) => {
                const year = getYear(record[0]);
                return year >= fromYear && year <= toYear;
            });

            chart.data.labels = filtered.map((record) => record[0]);
            const dataset = chart.data.datasets[0];

            if (!dataset) return;

            dataset.data = filtered.map((record) => record[2]);
            chart.update();
        }

        [fromEl, toEl].forEach((el) =>
            el.addEventListener("input", update),
        );
        window.addEventListener("ecofin-theme-change", applyTheme);

        update();
    });
</script>
