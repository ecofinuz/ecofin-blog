---
import { Icon } from "astro-icon/components";

interface Props {
    authorName: string;
    links: {
        telegram?: string;
        medium?: string;
        linkedin?: string;
        instagram?: string;
        x?: string;
        twitter?: string;
        bluesky?: string;
        mastodon?: string;
    };
}

const { authorName, links } = Astro.props;
const iconLinks = [
    { name: "telegram", href: links.telegram, label: "Telegram" },
    { name: "medium", href: links.medium, label: "Medium" },
    { name: "linkedin", href: links.linkedin, label: "LinkedIn" },
    { name: "instagram", href: links.instagram, label: "Instagram" },
    { name: "x", href: links.x ?? links.twitter, label: "X" },
    { name: "bluesky", href: links.bluesky, label: "Bluesky" },
    { name: "mastodon", href: links.mastodon, label: "Mastodon" },
] as const;
---

<div class="author-links">
    {
        iconLinks.map(({ name, href, label }) => (
            href && (
                <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="author-link author-link-icon"
                    aria-label={`${label}: ${authorName}`}
                >
                    <Icon name={name} class="author-link-icon-svg" aria-hidden="true" />
                </a>
            )
        ))
    }
</div>
