---
interface Props {
    lang?: string;
}

const { lang = "uz" } = Astro.props;

const t: Record<string, Record<string, string>> = {
    uz: {
        principal:      "Asosiy summa",
        rate:           "Foiz stavkasi",
        years:          "Muddat",
        yearsUnit:      "yil",
        simple:         "Sodda foiz",
        compound:       "Murakkab foiz",
        simpleLabel:    "Sodda foiz (yakuniy)",
        compoundLabel:  "Murakkab foiz (yakuniy)",
        diff:           "Farq",
        start:          "Boshida",
        yearUnit:       "-yil",
        currency:       "so'm",
        read:           "mlrd",
        mln:            "mln",
    },
    en: {
        principal:      "Principal",
        rate:           "Interest rate",
        years:          "Duration",
        yearsUnit:      "years",
        simple:         "Simple interest",
        compound:       "Compound interest",
        simpleLabel:    "Simple interest (final)",
        compoundLabel:  "Compound interest (final)",
        diff:           "Difference",
        start:          "Start",
        yearUnit:       "yr",
        currency:       "",
        read:           "B",
        mln:            "M",
    },
    ru: {
        principal:      "Основная сумма",
        rate:           "Процентная ставка",
        years:          "Срок",
        yearsUnit:      "лет",
        simple:         "Простой процент",
        compound:       "Сложный процент",
        simpleLabel:    "Простой процент (итог)",
        compoundLabel:  "Сложный процент (итог)",
        diff:           "Разница",
        start:          "Начало",
        yearUnit:       "-й год",
        currency:       "сум",
        read:           "млрд",
        mln:            "млн",
    },
};

const strings = t[lang] ?? t["uz"];
---

<div
    class="chart-container card-vessel"
    id="interest-chart-root"
    data-strings={JSON.stringify(strings)}
>
    <div class="sliders">
        <div class="slider-group">
            <label>{strings.principal} <span id="val-principal">10 {strings.mln}</span></label>
            <input type="range" id="principal" min="1000000" max="100000000" step="1000000" value="10000000" />
        </div>
        <div class="slider-group">
            <label>{strings.rate} <span id="val-rate">20%</span></label>
            <input type="range" id="rate" min="5" max="40" step="1" value="20" />
        </div>
        <div class="slider-group">
            <label>{strings.years} <span id="val-years">5 {strings.yearsUnit}</span></label>
            <input type="range" id="years" min="1" max="30" step="1" value="5" />
        </div>
    </div>

    <div class="chart-legend">
        <div class="legend-item">
            <div class="legend-dot"></div>
            {strings.simple}
        </div>
        <div class="legend-item">
            <div class="legend-dot compound"></div>
            {strings.compound}
        </div>
    </div>

    <canvas id="interestChart" height="300"></canvas>

    <div class="result-callout">
        <div class="item"><strong id="res-simple">—</strong>{strings.simpleLabel}</div>
        <div class="item"><strong id="res-compound">—</strong>{strings.compoundLabel}</div>
        <div class="item"><strong id="res-diff">—</strong>{strings.diff}</div>
    </div>
</div>

<script>
    import Chart, { type ChartData, type TooltipItem } from "chart.js/auto";

    const root = document.getElementById("interest-chart-root")!;
    const s = JSON.parse(root.dataset.strings!);

    const fmt = (n: number): string => {
        if (n >= 1e9) return (n / 1e9).toFixed(1).replace(/\.0$/, "") + " " + s.read;
        if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, "") + " " + s.mln;
        return n.toLocaleString();
    };

    const fmtFull = (n: number): string =>
        n.toLocaleString() + (s.currency ? " " + s.currency : "");

    const principalEl = document.getElementById("principal") as HTMLInputElement;
    const rateEl = document.getElementById("rate") as HTMLInputElement;
    const yearsEl = document.getElementById("years") as HTMLInputElement;
    const canvas = document.getElementById("interestChart") as HTMLCanvasElement;
    const getThemeColor = (name: string, fallback: string): string =>
        getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    const getChartColors = () => ({
        simple: getThemeColor("--line-simple", "#0f172a"),
        compound: getThemeColor("--line-compound", "#0f766e"),
        grid: getThemeColor("--chart-grid", "rgb(15 23 42 / 0.14)"),
        tick: getThemeColor("--chart-tick", "rgb(15 23 42 / 0.56)"),
        tooltipBg: getThemeColor("--chart-tooltip-bg", "#0f172a"),
        tooltipTitle: getThemeColor("--chart-tooltip-title", "#34d399"),
        tooltipBody: getThemeColor("--chart-tooltip-body", "#ffffff"),
    });

    const initialColors = getChartColors();

    const chartData: ChartData<"line", number[], string> = {
        labels: [],
        datasets: [
            {
                label: s.simple,
                data: [],
                borderColor: initialColors.simple,
                borderWidth: 2,
                pointRadius: 0,
                tension: 0,
                fill: false,
            },
            {
                label: s.compound,
                data: [],
                borderColor: initialColors.compound,
                borderWidth: 2,
                borderDash: [6, 4],
                pointRadius: 0,
                tension: 0,
                fill: false,
            },
        ],
    };

    const chart: Chart<"line", number[], string> = new Chart(canvas, {
        type: "line",
        data: chartData,
        options: {
            responsive: true,
            animation: { duration: 300 },
            interaction: { mode: "index", intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: initialColors.tooltipBg,
                    titleColor: initialColors.tooltipTitle,
                    bodyColor: initialColors.tooltipBody,
                    padding: 12,
                    callbacks: {
                        label: (ctx: TooltipItem<"line">) =>
                            `${ctx.dataset.label ?? ""}: ${fmtFull(
                                Math.round(ctx.parsed.y),
                            )}`,
                    },
                },
            },
            scales: {
                x: {
                    grid: { color: initialColors.grid },
                    ticks: { color: initialColors.tick, font: { size: 12 } },
                },
                y: {
                    grid: { color: initialColors.grid },
                    ticks: {
                        color: initialColors.tick,
                        font: { size: 12 },
                        callback: (v) => fmt(Number(v)),
                    },
                },
            },
        },
    });

    function applyTheme(): void {
        const colors = getChartColors();
        const [simpleDataset, compoundDataset] = chart.data.datasets;
        if (simpleDataset) simpleDataset.borderColor = colors.simple;
        if (compoundDataset) compoundDataset.borderColor = colors.compound;

        const options = chart.options as any;
        options.plugins.tooltip.backgroundColor = colors.tooltipBg;
        options.plugins.tooltip.titleColor = colors.tooltipTitle;
        options.plugins.tooltip.bodyColor = colors.tooltipBody;
        options.scales.x.grid.color = colors.grid;
        options.scales.x.ticks.color = colors.tick;
        options.scales.y.grid.color = colors.grid;
        options.scales.y.ticks.color = colors.tick;
        chart.update("none");
    }

    function update(): void {
        const P = +principalEl.value;
        const r = +rateEl.value / 100;
        const T = +yearsEl.value;

        document.getElementById("val-principal")!.textContent = fmt(P);
        document.getElementById("val-rate")!.textContent = rateEl.value + "%";
        document.getElementById("val-years")!.textContent = yearsEl.value + " yil";

        const labels: string[] = [];
        const simple: number[] = [];
        const compound: number[] = [];

        for (let t = 0; t <= T; t++) {
            labels.push(t === 0 ? "Boshida" : t + "-yil");
            simple.push(P * (1 + r * t));
            compound.push(P * Math.pow(1 + r, t));
        }

        chart.data.labels = labels;
        const simpleDataset = chart.data.datasets[0];
        const compoundDataset = chart.data.datasets[1];

        if (!simpleDataset || !compoundDataset) return;

        simpleDataset.data = simple;
        compoundDataset.data = compound;
        chart.update();

        const finalSimple = P * (1 + r * T);
        const finalCompound = P * Math.pow(1 + r, T);
        const diff = finalCompound - finalSimple;

        document.getElementById("res-simple")!.textContent = fmtFull(Math.round(finalSimple));
        document.getElementById("res-compound")!.textContent = fmtFull(Math.round(finalCompound));
        document.getElementById("res-diff")!.textContent = "+" + fmtFull(Math.round(diff));
    }

    [principalEl, rateEl, yearsEl].forEach((el) =>
        el.addEventListener("input", update)
    );
    window.addEventListener("ecofin-theme-change", applyTheme);

    update();
</script>
