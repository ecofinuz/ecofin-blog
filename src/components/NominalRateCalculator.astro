---
interface Props {
  lang?: string;
}

const { lang = "uz" } = Astro.props;

const t: Record<string, Record<string, string>> = {
  uz: {
    title: "Nominal foiz stavkasi",
    resultLabel: "Nominal foiz stavkasi (R)",
    risk: "Risk mukofoti",
    margin: "Foyda marjasi",
    inflation: "Inflyatsiya",
  },
  en: {
    title: "Nominal interest rate",
    resultLabel: "Nominal interest rate (R)",
    risk: "Risk premium",
    margin: "Profit margin",
    inflation: "Inflation",
  },
  ru: {
    title: "Номинальная процентная ставка",
    resultLabel: "Номинальная процентная ставка (R)",
    risk: "Премия за риск",
    margin: "Маржа прибыли",
    inflation: "Инфляция",
  },
};

const strings = t[lang] ?? t.uz;
---

<div
  class="nominal-rate-calculator calc-container card-vessel"
  data-strings={JSON.stringify(strings)}
>
  <div class="result-display">
    <p class="result-label">{strings.resultLabel}</p>
    <div class="result-R" data-result-r>49.0%</div>
    <p class="result-sub" data-result-sub>
      (1 + 0.23) x (1 + 0.13) x (1 + 0.07) = 1.490
    </p>
  </div>

  <div class="breakdown">
    <div class="breakdown-item">
      <div class="b-label">{strings.risk}</div>
      <div class="b-value" data-b-risk>23.0%</div>
      <div class="b-name">r</div>
    </div>

    <div class="breakdown-item">
      <div class="b-label">{strings.margin}</div>
      <div class="b-value" data-b-margin>13.0%</div>
      <div class="b-name">m</div>
    </div>

    <div class="breakdown-item">
      <div class="b-label">{strings.inflation}</div>
      <div class="b-value" data-b-inflation>7.0%</div>
      <div class="b-name">π</div>
    </div>
  </div>

  <div class="sliders">
    <div class="slider-group">
      <label>{strings.risk} <span data-val-risk>23%</span></label>
      <input type="range" data-sl-risk min="5" max="50" step="0.5" value="23" />
    </div>

    <div class="slider-group">
      <label>{strings.margin} <span data-val-margin>13%</span></label>
      <input type="range" data-sl-margin min="2" max="30" step="0.5" value="13" />
    </div>

    <div class="slider-group">
      <label>{strings.inflation} <span data-val-inflation>7%</span></label>
      <input type="range" data-sl-inflation min="1" max="30" step="0.5" value="7" />
    </div>
  </div>
</div>

<script>
  const calculators = document.querySelectorAll<HTMLElement>(
    ".nominal-rate-calculator"
  );

  calculators.forEach((root) => {
    const slRisk = root.querySelector<HTMLInputElement>("[data-sl-risk]")!;
    const slMargin = root.querySelector<HTMLInputElement>("[data-sl-margin]")!;
    const slInflation = root.querySelector<HTMLInputElement>("[data-sl-inflation]")!;

    const resultR = root.querySelector<HTMLElement>("[data-result-r]")!;
    const resultSub = root.querySelector<HTMLElement>("[data-result-sub]")!;

    const valRisk = root.querySelector<HTMLElement>("[data-val-risk]")!;
    const valMargin = root.querySelector<HTMLElement>("[data-val-margin]")!;
    const valInflation = root.querySelector<HTMLElement>("[data-val-inflation]")!;

    const bRisk = root.querySelector<HTMLElement>("[data-b-risk]")!;
    const bMargin = root.querySelector<HTMLElement>("[data-b-margin]")!;
    const bInflation = root.querySelector<HTMLElement>("[data-b-inflation]")!;

    function update(): void {
      const riskPct = Number(slRisk.value);
      const marginPct = Number(slMargin.value);
      const inflationPct = Number(slInflation.value);

      const r = riskPct / 100;
      const m = marginPct / 100;
      const p = inflationPct / 100;

      const R = (1 + r) * (1 + m) * (1 + p) - 1;

      valRisk.textContent = `${riskPct}%`;
      valMargin.textContent = `${marginPct}%`;
      valInflation.textContent = `${inflationPct}%`;

      bRisk.textContent = `${riskPct.toFixed(1)}%`;
      bMargin.textContent = `${marginPct.toFixed(1)}%`;
      bInflation.textContent = `${inflationPct.toFixed(1)}%`;

      resultR.textContent = `${(R * 100).toFixed(1)}%`;
      resultSub.textContent =
        `(1 + ${r.toFixed(2)}) × (1 + ${m.toFixed(2)}) × (1 + ${p.toFixed(2)}) = ${(1 + R).toFixed(3)}`;
    }

    [slRisk, slMargin, slInflation].forEach((el) =>
      el.addEventListener("input", update)
    );

    update();
  });
</script>
