---
interface Props {
    title: string;
    description?: string;
    lang?: string;
    ogImage?: string;
    languageLinks?: Partial<LanguageLinks>;
    seoLanguageLinks?: Partial<LanguageLinks>;
    pageType?: "website" | "article";
    publishedTime?: Date;
    updatedTime?: Date;
    authorName?: string;
    authorUrl?: string;
    authorImage?: string;
    authorDescription?: string;
    authorSameAs?: string[];
    articleSection?: string;
}

import "bootstrap/dist/css/bootstrap.min.css";
import "@styles/global.css";
import "@styles/interactive.css";
import type { LanguageLinks } from "@utils/languageLinks";
import { getLocalizedHomeLinks } from "@utils/languageLinks";

const {
    title,
    description,
    lang = "uz",
    ogImage,
    languageLinks,
    seoLanguageLinks,
    pageType = "website",
    publishedTime,
    updatedTime,
    authorName,
    authorUrl,
    authorImage,
    authorDescription,
    authorSameAs,
    articleSection,
} = Astro.props;

const t: Record<string, Record<string, string>> = {
    uz: {
        platform:  "ecofin.uz",
        sponsor:   "Qo'llash",
        navTagline: "Ochiq moliyaviy bilim, hamma uchun",
        tagline:   "Ecofin ochiq kod asosida ishlaydigan moliyaviy ta'lim kompaniyasi.",
        companyLine: "Ochiq kod asosidagi moliyaviy ta'lim kompaniyasi.",
        footerExplore: "Ko‘rish",
        footerBlog: "Blog",
        footerTopics: "Mavzular",
        footerCommunity: "Hamjamiyat",
    },
    en: {
        platform:  "ecofin.uz",
        sponsor:   "Sponsor",
        navTagline: "Open finance knowledge, for everyone",
        tagline:   "Ecofin is an open-source financial education company.",
        companyLine: "An open-source financial education company.",
        footerExplore: "Explore",
        footerBlog: "Blog",
        footerTopics: "Topics",
        footerCommunity: "Community",
    },
    ru: {
        platform:  "ecofin.uz",
        sponsor:   "Поддержать",
        navTagline: "Открытые финансовые знания, для всех",
        tagline:   "Ecofin - компания финансового образования с открытым исходным кодом.",
        companyLine: "Компания финансового образования с открытым исходным кодом.",
        footerExplore: "Разделы",
        footerBlog: "Блог",
        footerTopics: "Темы",
        footerCommunity: "Сообщество",
    },
};

const ui = t[lang] ?? t["uz"];
const pageDescription = description ?? ui.tagline;
const themeLabel = {
    uz: "Rang mavzusini almashtirish",
    en: "Toggle color theme",
    ru: "Переключить тему",
}[lang] ?? "Toggle color theme";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL("/", Astro.site);
const homeHref = lang === "uz" ? "/" : `/${lang}/`;
const topicsHref = `${homeHref}#topics`;
const footerCopy = `© 2026 Ecofin. ${ui.navTagline}.`;
const resolvedLanguageLinks = {
    ...getLocalizedHomeLinks(),
    ...languageLinks,
};
const resolvedSeoLanguageLinks = seoLanguageLinks ?? resolvedLanguageLinks;
const languages = [
    { code: "uz", label: "UZ", href: resolvedLanguageLinks.uz },
    { code: "en", label: "EN", href: resolvedLanguageLinks.en },
    { code: "ru", label: "RU", href: resolvedLanguageLinks.ru },
];
const seoLanguages = [
    { code: "uz", locale: "uz_UZ", href: resolvedSeoLanguageLinks.uz },
    { code: "en", locale: "en_US", href: resolvedSeoLanguageLinks.en },
    { code: "ru", locale: "ru_RU", href: resolvedSeoLanguageLinks.ru },
].filter((language) => language.href);
const currentLocale = seoLanguages.find((language) => language.code === lang)
    ?.locale ?? "uz_UZ";
const alternateLocales = seoLanguages.filter((language) => language.code !== lang);
const xDefaultHref = resolvedSeoLanguageLinks.uz ?? resolvedSeoLanguageLinks.en ?? resolvedSeoLanguageLinks.ru;
const pageTitle = `${title} | Ecofin`;
const resolvedOgImage = new URL(ogImage ?? "/ecofin-favicon.png", Astro.site);
const ogType = pageType === "article" ? "article" : "website";
const publishedISO = publishedTime?.toISOString();
const updatedISO = (updatedTime ?? publishedTime)?.toISOString();
const resolvedAuthorUrl = authorUrl
    ? new URL(authorUrl, Astro.site).href
    : undefined;
const articleAuthor = {
    "@type": "Person",
    "@id": resolvedAuthorUrl ? `${resolvedAuthorUrl}#person` : undefined,
    name: authorName ?? "Ecofin",
    url: resolvedAuthorUrl,
    image: authorImage ? new URL(authorImage, Astro.site).href : undefined,
    description: authorDescription,
    sameAs: authorSameAs?.length ? authorSameAs : undefined,
};
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": new URL("/#organization", Astro.site).href,
            name: "Ecofin",
            url: siteURL.href,
            logo: {
                "@type": "ImageObject",
                url: new URL("/ecofin-favicon.png", Astro.site).href,
                width: 152,
                height: 128,
            },
            sameAs: [
                "https://ecofin.uz/",
                "https://github.com/ecofinuz",
                "https://t.me/ecofin_uz",
            ],
        },
        {
            "@type": "WebSite",
            "@id": new URL("/#website", Astro.site).href,
            url: siteURL.href,
            name: "Ecofin Blog",
            description: ui.tagline,
            publisher: {
                "@id": new URL("/#organization", Astro.site).href,
            },
            inLanguage: lang,
        },
        pageType === "article"
            ? {
                  "@type": "BlogPosting",
                  "@id": `${canonicalURL.href}#article`,
                  mainEntityOfPage: canonicalURL.href,
                  headline: title,
                  description: pageDescription,
                  image: resolvedOgImage.href,
                  datePublished: publishedISO,
                  dateModified: updatedISO,
                  author: articleAuthor,
                  publisher: {
                      "@id": new URL("/#organization", Astro.site).href,
                  },
                  articleSection,
                  inLanguage: lang,
              }
            : {
                  "@type": "WebPage",
                  "@id": `${canonicalURL.href}#webpage`,
                  url: canonicalURL.href,
                  name: pageTitle,
                  description: pageDescription,
                  isPartOf: {
                      "@id": new URL("/#website", Astro.site).href,
                  },
                  about: {
                      "@id": new URL("/#organization", Astro.site).href,
                  },
                  primaryImageOfPage: {
                      "@type": "ImageObject",
                      url: resolvedOgImage.href,
                  },
                  inLanguage: lang,
              },
    ],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#fffefb" />
        <meta name="robots" content="index, follow" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="canonical" href={canonicalURL.href} />
        {
            seoLanguages.map((language) => (
                <link
                    rel="alternate"
                    hreflang={language.code}
                    href={new URL(language.href!, Astro.site).href}
                />
            ))
        }
        {xDefaultHref && (
            <link
                rel="alternate"
                hreflang="x-default"
                href={new URL(xDefaultHref, Astro.site).href}
            />
        )}
        <link rel="icon" href="/ecofin-favicon.png" type="image/png" />
        <link rel="apple-touch-icon" href="/ecofin-favicon.png" />

        <!-- Open Graph -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:site_name" content="Ecofin" />
        <meta property="og:locale" content={currentLocale} />
        {
            alternateLocales.map((language) => (
                <meta property="og:locale:alternate" content={language.locale} />
            ))
        }
        <meta property="og:image" content={resolvedOgImage.href} />
        <meta property="og:image:secure_url" content={resolvedOgImage.href} />
        <meta property="og:image:alt" content={pageTitle} />
        {pageType === "article" && publishedISO && (
            <meta property="article:published_time" content={publishedISO} />
        )}
        {pageType === "article" && updatedISO && (
            <meta property="article:modified_time" content={updatedISO} />
        )}
        {pageType === "article" && authorName && (
            <meta property="article:author" content={authorName} />
        )}
        {pageType === "article" && articleSection && (
            <meta property="article:section" content={articleSection} />
        )}

        <!-- Twitter -->
        <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={resolvedOgImage.href} />
        <meta name="twitter:image:alt" content={pageTitle} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300;400;600&display=swap"
            rel="stylesheet"
        />

        <link rel="alternate" type="application/rss+xml" title="Ecofin Blog (UZ)" href="/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title="Ecofin Blog (EN)" href="/en/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title="Ecofin Blog (RU)" href="/ru/rss.xml" />
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
        <script is:inline>
            (() => {
                try {
                    if (localStorage.getItem("ecofin-theme") === "dark") {
                        document.documentElement.dataset.theme = "dark";
                        document
                            .querySelector('meta[name="theme-color"]')
                            ?.setAttribute("content", "#050807");
                    }
                } catch {
                    // Ignore unavailable storage.
                }
            })();
        </script>
        <slot name="head" />
        <!-- Google tag (gtag.js) -->
        <script type="application/javascript"
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-R73J85XQ5N"
        ></script>
        <script type="application/javascript">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-R73J85XQ5N");
        </script>
    </head>
    <body>
        <nav class="site-nav">
            <div class="nav-inner">
                <a href={homeHref} class="nav-brand">
                    <img
                        src="/ecofin-favicon.png"
                        alt=""
                        class="nav-brand-logo"
                        width="28"
                        height="28"
                    />
                    <span class="nav-brand-copy">
                        <span class="nav-brand-name">Ecofin</span>
                        <span class="nav-brand-tagline">{ui.navTagline}</span>
                    </span>
                </a>
                <div class="nav-links">
                    <a href="https://ecofin.uz/" class="nav-link nav-link-site">ecofin.uz</a>
                    <a
                        href="https://github.com/ecofinuz"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="nav-link nav-github"
                        aria-label="GitHub"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                        <span class="nav-github-label">GitHub</span>
                    </a>
                    <div class="language-switch" aria-label="Language selector">
                        {
                            languages.map((language) => (
                                <a
                                    href={language.href}
                                    class={`language-option${lang === language.code ? " active" : ""}`}
                                    hreflang={language.code}
                                    lang={language.code}
                                    aria-current={lang === language.code ? "page" : undefined}
                                >
                                    {language.label}
                                </a>
                            ))
                        }
                    </div>
                    <button
                        class="theme-toggle"
                        type="button"
                        aria-label={themeLabel}
                        data-theme-toggle
                    >
                        <svg
                            class="theme-toggle-moon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z" />
                        </svg>
                        <svg
                            class="theme-toggle-sun"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2" />
                            <path d="M12 20v2" />
                            <path d="m4.93 4.93 1.41 1.41" />
                            <path d="m17.66 17.66 1.41 1.41" />
                            <path d="M2 12h2" />
                            <path d="M20 12h2" />
                            <path d="m6.34 17.66-1.41 1.41" />
                            <path d="m19.07 4.93-1.41 1.41" />
                        </svg>
                    </button>
                    <a
                        href="https://ecofin.uz/support/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="nav-donate"
                    >
                        {ui.sponsor}
                    </a>
                </div>
            </div>
        </nav>

        <slot />

        <footer class="site-footer">
            <div class="container footer-inner">
                <div class="footer-grid">
                    <div class="footer-brand-block">
                        <span class="footer-brand">Ecofin</span>
                        <p class="footer-tagline">{ui.navTagline}</p>
                        <p class="footer-open-source">{ui.companyLine}</p>
                    </div>

                    <div class="footer-column">
                        <p class="footer-heading">{ui.footerExplore}</p>
                        <nav class="footer-links" aria-label={ui.footerExplore}>
                            <a href={homeHref} class="footer-link">
                                {ui.footerBlog}
                            </a>
                            <a href={topicsHref} class="footer-link">
                                {ui.footerTopics}
                            </a>
                            <a href="https://ecofin.uz/" class="footer-link">
                                {ui.platform}
                            </a>
                        </nav>
                    </div>

                    <div class="footer-column">
                        <p class="footer-heading">{ui.footerCommunity}</p>
                        <nav class="footer-links" aria-label={ui.footerCommunity}>
                            <a
                                href="https://github.com/ecofinuz"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="footer-link"
                            >
                                GitHub
                            </a>
                            <a
                                href="https://t.me/ecofin_uz"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="footer-link"
                            >
                                Telegram
                            </a>
                        </nav>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p class="footer-copy">{footerCopy}</p>
                </div>
            </div>
        </footer>
        <script is:inline>
            (() => {
                const storageKey = "ecofin-theme";
                const root = document.documentElement;
                const metaTheme = document.querySelector(
                    'meta[name="theme-color"]',
                );
                const buttons = document.querySelectorAll("[data-theme-toggle]");

                const setTheme = (theme) => {
                    const isDark = theme === "dark";
                    root.dataset.theme = isDark ? "dark" : "";
                    if (!isDark) {
                        delete root.dataset.theme;
                    }
                    metaTheme?.setAttribute("content", isDark ? "#050807" : "#fffefb");
                    buttons.forEach((button) => {
                        button.setAttribute("aria-pressed", String(isDark));
                    });
                    window.dispatchEvent(
                        new CustomEvent("ecofin-theme-change", {
                            detail: { theme: isDark ? "dark" : "light" },
                        }),
                    );
                };

                buttons.forEach((button) => {
                    button.addEventListener("click", () => {
                        const nextTheme =
                            root.dataset.theme === "dark" ? "light" : "dark";
                        try {
                            if (nextTheme === "dark") {
                                localStorage.setItem(storageKey, "dark");
                            } else {
                                localStorage.removeItem(storageKey);
                            }
                        } catch {
                            // Ignore unavailable storage.
                        }
                        setTheme(nextTheme);
                    });
                });

                setTheme(root.dataset.theme === "dark" ? "dark" : "light");
            })();
        </script>
    </body>
</html>
