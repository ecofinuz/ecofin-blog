---
import type { AuthorKey } from "@data/authors";
import { getAuthor } from "@data/authors";
import type { CategoryKey } from "@data/categories";
import { categories } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const locale = "uz";

export async function getStaticPaths() {
    return (Object.keys(categories) as CategoryKey[]).map((key) => ({
        params: { category: categories[key].uz.slug },
        props: { categoryKey: key },
    }));
}

const { category } = Astro.params;
const { categoryKey } = Astro.props;
const categorySlug = categories[categoryKey].uz.slug;

const allPosts = await getCollection("blog", ({ id }) =>
    id.startsWith(`${locale}/${categorySlug}/`)
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const catLabel = categories[categoryKey].uz.label;

function formatDate(date: Date): string {
    return date.toLocaleDateString("uz-UZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}
---

<Layout title={catLabel} lang={locale}>
    <main>
        <div class="container">

            <div class="category-header">
                <a href="/" class="label-small back-link">← Barcha maqolalar</a>
                <h1>{catLabel}</h1>
                <p class="label-small">{posts.length} ta maqola</p>
            </div>

            <div class="post-list">
                {
                    posts.map((post) => {
                        const slug = getSlug(post.id);
                        const author = getAuthor(post.data.author as AuthorKey);
                        
                        return (
                            <a
                                href={`/${category}/${slug}/`}
                                class="post-item"
                            >
                                <div class="post-meta-row">
                                    <span class="post-date label-small">
                                        {formatDate(post.data.date)}
                                    </span>
                                    <span class="label-small">
                                        &middot;
                                    </span>
                                    {post.data.series && (
                                        <span class="label-small post-date">
                                            {post.data.series.part}-qism
                                        </span>
                                    )}
                                </div>
                                <h2 class="post-title">{post.data.title}</h2>
                                <p class="post-excerpt">{post.data.description}</p>
                                <div class="post-footer">
                                    <span class="post-read">O'qish &rarr;</span>
                                    
                                    <div class="post-item-byline">
                                        <span class="byline-author">{author.name}</span>
                                        <span class="sep">&middot;</span>
                                        <span class="post-date">{formatDate(post.data.date)}</span>
                                    </div>
                                </div>
                            </a>
                        );
                    })
                }
            </div>

        </div>
    </main>
</Layout>