---
import type { AuthorKey } from "@data/authors";
import { getAuthor } from "@data/authors";
import { getCategoryDetailsFromSlug } from "@data/categories";
import ArticleFooter from "@components/ArticleFooter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import BylineAuthor from "@components/BylineAuthor.astro";
import Layout from "@layouts/Layout.astro";
import PostDate from "@components/PostDate.astro";
import PostCover from "@components/PostCover.astro";
import ReadingTime from "@components/ReadingTime.astro";
import ReadingProgress from "@components/ReadingProgress.astro";
import SeriesNavigation from "@components/SeriesNavigation.astro";
import ShareActions from "@components/ShareActions.astro";
import { getLocalizedPostLinks } from "@utils/languageLinks";
import { getSeriesNavigation } from "@utils/seriesNavigation";
import { getMinutesRead } from "@utils/readingTime";
import { getCollection, render } from "astro:content";
const locale = "uz";

export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    const posts = allPosts.filter(({ id }) =>
        id.startsWith("uz/")
    );

    return posts.map((post) => {
        const parts = post.id.split("/");
        const category = parts[1];
        const slug = parts[2];

        const cat = getCategoryDetailsFromSlug(category, "uz");

        return {
            params: { category: cat.slug, slug },
            props: {
                post,
                languageLinks: getLocalizedPostLinks(post, allPosts),
                seriesNavigation: getSeriesNavigation(post, posts),
            },
        };
    });
}

const { post, languageLinks, seriesNavigation } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead = getMinutesRead(remarkPluginFrontmatter);
const author = getAuthor(post.data.author as AuthorKey);

const parts = post.id.split("/");
const cat = getCategoryDetailsFromSlug(parts[1], locale);
const catLabel = cat.label;
const catSlug = cat.slug;
const ogImage = post.data.cover
    ? new URL(`/images/covers/${post.data.cover}`, Astro.site).href
    : undefined;

function formatDate(date: Date): string {
    return date.toLocaleDateString("uz-UZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}
---

<Layout title={post.data.title} description={post.data.description} lang={locale} ogImage={ogImage} languageLinks={languageLinks}>
    <ReadingProgress />
    <main>
        <div class="container">

            <div class="post-header">
                <Breadcrumbs
                    lang={locale}
                    categoryLabel={catLabel}
                    categoryHref={`/${catSlug}/`}
                    postTitle={post.data.title}
                />
                <div class="post-meta-row">
                    <a href={`/${catSlug}/`} class="post-category label-small">
                        {catLabel}
                    </a>
                    {post.data.part && (
                        <>
                            <span class="label-small">
                                &middot;
                            </span>
                            <span class="label-small post-date">
                                {post.data.part}-qism
                            </span>
                        </>
                    )}
                </div>
                <h1>{post.data.title}</h1>
                <p class="post-description">{post.data.description}</p>
                <div class="post-byline">
                    <BylineAuthor
                        name={author.name}
                        href={`/author/${post.data.author}/`}
                        class="label-small"
                    />
                    <span class="label-small">
                        &middot;
                    </span>
                    <PostDate date={formatDate(post.data.date)} class="label-small" />
                    <span class="label-small">
                        &middot;
                    </span>
                    <ReadingTime locale={locale} minutesRead={minutesRead} class="label-small" />
                    <span class="label-small post-share-separator">
                        &middot;
                    </span>
                    <ShareActions
                        lang={locale}
                        title={post.data.title}
                        text={post.data.description}
                        variant="inline"
                    />
                </div>
                <PostCover
                    cover={post.data.cover}
                    title={post.data.title}
                    className="post-hero-cover"
                    loading="eager"
                />
            </div>

            <article class="post-body">
                <Content />
                <ArticleFooter
                    locale={locale}
                    author={author}
                    authorHref={`/author/${post.data.author}/`}
                    title={post.data.title}
                    description={post.data.description}
                />
                <SeriesNavigation
                    locale={locale}
                    previousPost={seriesNavigation.previousPost}
                    nextPost={seriesNavigation.nextPost}
                />
            </article>

        </div>
    </main>
</Layout>
