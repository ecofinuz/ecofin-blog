---
import type { AuthorKey } from "@data/authors";
import { getAuthor } from "@data/authors";
import type { CategoryKey } from "@data/categories";
import { categories, getCategoryDetailsFromSlug } from "@data/categories";
import HomeHero from "@components/HomeHero.astro";
import Layout from "@layouts/Layout.astro";
import PostCover from "@components/PostCover.astro";
import { getCollection } from "astro:content";

const locale = "ru";

// Get all Russian posts, sorted by date descending
const allPosts = await getCollection("blog", ({ id }) =>
    id.startsWith(`${locale}/`)
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date): string {
    return date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

// Derive slug from entry id:
function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}

// Derive category slug from entry id: "ru/kredit/prostie-i-slojnie-protsenti" -> "kredit"
function getCategory(id: string): string {
    const parts = id.split("/");
    return parts[1];
}

const latestPost = posts[0];
const latestCategory = latestPost
    ? getCategoryDetailsFromSlug(getCategory(latestPost.id), locale)
    : undefined;
const latestHref = latestPost && latestCategory
    ? `/ru/${latestCategory.slug}/${getSlug(latestPost.id)}/`
    : "#articles";
const postCountWord =
    posts.length % 10 === 1 && posts.length % 100 !== 11
        ? "публикация"
        : posts.length % 10 >= 2 && posts.length % 10 <= 4 && (posts.length % 100 < 10 || posts.length % 100 >= 20)
          ? "публикации"
          : "публикаций";
const postCountLabel = `${posts.length} ${postCountWord}`;
---

<Layout title="Главная страница" lang={locale}>
    <main class="home-main">
        <HomeHero
            lang={locale}
            postCount={posts.length}
            categoryCount={Object.keys(categories).length}
            latestHref={latestHref}
            latestTitle={latestPost?.data.title}
            latestCategory={latestCategory?.label}
        />

        <div class="container">

            <section class="categories-section home-section">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Темы</p>
                        <h2 class="section-title">Выберите направление</h2>
                    </div>
                </div>
                <div class="category-list">
                    {
                        (Object.keys(categories) as CategoryKey[]).map((key) => (
                            <a
                                href={`/ru/${categories[key][locale].slug}/`}
                                class="category-tag"
                            >
                                {categories[key][locale].label}
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="posts-section home-section" id="articles">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Публикации</p>
                        <h2 class="section-title">Свежие публикации</h2>
                    </div>
                    <p class="section-note">{postCountLabel}</p>
                </div>
                <div class="post-list">
                    {
                        posts.map((post) => {
                            const cat = getCategoryDetailsFromSlug(getCategory(post.id), locale);
                            const slug = getSlug(post.id);
                            const author = getAuthor(post.data.author as AuthorKey);

                            return (
                                <a
                                    href={`/ru/${cat.slug}/${slug}/`}
                                    class="post-item"
                                >
                                    <PostCover
                                        cover={post.data.cover}
                                        title={post.data.title}
                                        className="post-item-cover"
                                        decorative
                                    />
                                    <div class="post-meta-row">
                                        <span class="post-category label-small">
                                            {cat.label}
                                        </span>
                                        {post.data.part && (
                                            <>
                                                <span class="label-small">
                                                    &middot;
                                                </span>
                                                <span class="label-small post-date">
                                                    {post.data.part}-часть
                                                </span>
                                            </>
                                        )}
                                    </div>
                                    <h2 class="post-title">{post.data.title}</h2>
                                    <p class="post-excerpt">
                                        {post.data.description}
                                    </p>
                                    <div class="post-footer">
                                        <span class="post-read">Прочитать &rarr;</span>
                                        
                                        <div class="post-item-byline">
                                            <span class="byline-author">{author.name}</span>
                                            <span class="sep">&middot;</span>
                                            <span class="post-date">{formatDate(post.data.date)}</span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })
                    }
                </div>
            </section>

        </div>
    </main>
</Layout>
