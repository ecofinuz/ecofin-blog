---
import HomeHero from "@components/HomeHero.astro";
import PostCard from "@components/PostCard.astro";
import PostFilters from "@components/PostFilters.astro";
import type { CategoryKey } from "@data/categories";
import { categories, getCategoryDetailsFromSlug } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "ru";

// Get all Russian posts, sorted by date descending
const allPosts = await getCollection("blog", ({ id }) =>
    id.startsWith(`${locale}/`)
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);
const postListId = "home-post-list-ru";
const authorKeys = posts.map((post) => post.data.author);

function formatDate(date: Date): string {
    return date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

// Derive slug from entry id:
function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}

// Derive category slug from entry id: "ru/kredit/prostie-i-slojnie-protsenti" -> "kredit"
function getCategory(id: string): string {
    const parts = id.split("/");
    return parts[1];
}

const latestPost = posts[0];
const latestCategory = latestPost
    ? getCategoryDetailsFromSlug(getCategory(latestPost.id), locale)
    : undefined;
const latestHref = latestPost && latestCategory
    ? `/ru/${latestCategory.slug}/${getSlug(latestPost.id)}/`
    : "#articles";
---

<Layout
    title="Финансы простым языком"
    description="Блог Ecofin публикует простые материалы о деньгах, кредитах, инфляции, банках, рынках и повседневных финансовых решениях."
    lang={locale}
>
    <main class="home-main">
        <HomeHero
            lang={locale}
            latestHref={latestHref}
            latestTitle={latestPost?.data.title}
        />

        <div class="container">

            <section class="categories-section home-section" id="topics">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Темы</p>
                    </div>
                </div>
                <div class="category-list">
                    {
                        (Object.keys(categories) as CategoryKey[]).map((key) => (
                            <a
                                href={`/ru/${categories[key][locale].slug}/`}
                                class="category-tag"
                            >
                                {categories[key][locale].label}
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="posts-section home-section" id="articles">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Публикации</p>
                        <h2 class="section-title">Последние публикации</h2>
                    </div>
                </div>
                <PostFilters
                    lang={locale}
                    listId={postListId}
                    authorKeys={authorKeys}
                    total={posts.length}
                />
                <div class="post-list home-post-list row row-cols-1 row-cols-md-2 g-4" id={postListId}>
                    {
                        postsWithReadingTime.map(({ post, minutesRead }) => {
                            const cat = getCategoryDetailsFromSlug(getCategory(post.id), locale);
                            const slug = getSlug(post.id);

                            return (
                                <PostCard
                                    href={`/ru/${cat.slug}/${slug}/`}
                                    title={post.data.title}
                                    description={post.data.description}
                                    cover={post.data.cover}
                                    categoryLabel={cat.label}
                                    part={post.data.part}
                                    partLabel={post.data.part ? `${post.data.part}-часть` : undefined}
                                    date={formatDate(post.data.date)}
                                    dateTime={post.data.date.getTime()}
                                    minutesRead={minutesRead}
                                    locale={locale}
                                    readLabel="Читать"
                                    authorKey={post.data.author}
                                />
                            );
                        })
                    }
                </div>
            </section>

        </div>
    </main>
</Layout>
