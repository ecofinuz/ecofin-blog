---
import type { CategoryKey } from "@data/categories";
import { categories } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import PostDate from "@components/PostDate.astro";
import PostCover from "@components/PostCover.astro";
import ReadingTime from "@components/ReadingTime.astro";
import { getLocalizedCategoryLinks } from "@utils/languageLinks";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "ru";

export async function getStaticPaths() {
    return (Object.keys(categories) as CategoryKey[]).map((key) => ({
        params: { category: categories[key].ru.slug },
        props: { categoryKey: key },
    }));
}

const { category } = Astro.params;
const { categoryKey } = Astro.props;
const categorySlug = categories[categoryKey].ru.slug;
const languageLinks = getLocalizedCategoryLinks(categoryKey);

const allPosts = await getCollection("blog", ({ id }) =>
    id.startsWith(`${locale}/${categorySlug}/`)
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);

const catLabel = categories[categoryKey].ru.label;
const catDescription = categories[categoryKey].ru.description;
const postCountLabel = formatPostCount(posts.length);

function formatPostCount(count: number): string {
    const lastTwo = count % 100;
    const last = count % 10;

    if (lastTwo >= 11 && lastTwo <= 14) {
        return `${count} публикаций`;
    }

    if (last === 1) {
        return `${count} публикация`;
    }

    if (last >= 2 && last <= 4) {
        return `${count} публикации`;
    }

    return `${count} публикаций`;
}

function formatDate(date: Date): string {
    return date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}
---

<Layout
    title={catLabel}
    description={catDescription}
    lang={locale}
    languageLinks={languageLinks}
>
    <main>
        <div class="container">

            <div class="category-header">
                <a href="/ru/" class="label-small back-link">← Все публикации</a>
                <h1>{catLabel}</h1>
                <p class="category-description">{catDescription}</p>
                <p class="category-meta label-small">{postCountLabel}</p>
            </div>

            <div class="post-list home-post-list">
                {
                    postsWithReadingTime.map(({ post, minutesRead }) => {
                        const slug = getSlug(post.id);

                        return (
                            <a
                                href={`/ru/${category}/${slug}/`}
                                class="post-item home-post-item"
                            >
                                <PostCover
                                    cover={post.data.cover}
                                    title={post.data.title}
                                    className="post-item-cover home-post-cover"
                                    placeholderLabel={catLabel}
                                    placeholderTitle={post.data.title}
                                    decorative
                                />
                                <div class="post-meta-row home-post-meta">
                                    <span class="post-category label-small">
                                        {catLabel}
                                    </span>
                                    {post.data.part && (
                                        <>
                                            <span class="post-meta-separator" aria-hidden="true">
                                                &middot;
                                            </span>
                                            <span class="label-small post-date home-post-part">
                                                {post.data.part}-часть
                                            </span>
                                        </>
                                    )}
                                </div>
                                <h2 class="post-title">{post.data.title}</h2>
                                <p class="post-excerpt">{post.data.description}</p>
                                <div class="post-footer home-post-footer">
                                    <span class="post-read">Читать &rarr;</span>

                                    <div class="post-card-details">
                                        <PostDate date={formatDate(post.data.date)} class="label-small" />
                                        <span class="post-meta-separator" aria-hidden="true">&middot;</span>
                                        <ReadingTime
                                            locale={locale}
                                            minutesRead={minutesRead}
                                            class="label-small"
                                        />
                                    </div>
                                </div>
                            </a>
                        );
                    })
                }
            </div>

        </div>
    </main>
</Layout>
