---
import type { CategoryKey } from "@data/categories";
import { categories } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import PostFilters from "@components/PostFilters.astro";
import { getLocalizedCategoryLinks } from "@utils/languageLinks";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "ru";

export async function getStaticPaths() {
    return (Object.keys(categories) as CategoryKey[]).map((key) => ({
        params: { category: categories[key].ru.slug },
        props: { categoryKey: key },
    }));
}

const { category } = Astro.params;
const { categoryKey } = Astro.props;
const categorySlug = categories[categoryKey].ru.slug;
const languageLinks = getLocalizedCategoryLinks(categoryKey);

const allPosts = await getCollection("blog", ({ id, data }) =>
    id.startsWith(`${locale}/${categorySlug}/`) &&
    data.category === categorySlug
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);
const postListId = `${locale}-${categorySlug}-post-list`;
const authorKeys = posts.map((post) => post.data.author);

const catLabel = categories[categoryKey].ru.label;
const catDescription = categories[categoryKey].ru.description;
const postCountLabel = formatPostCount(posts.length);

function formatPostCount(count: number): string {
    const lastTwo = count % 100;
    const last = count % 10;

    if (lastTwo >= 11 && lastTwo <= 14) {
        return `${count} публикаций`;
    }

    if (last === 1) {
        return `${count} публикация`;
    }

    if (last >= 2 && last <= 4) {
        return `${count} публикации`;
    }

    return `${count} публикаций`;
}

function formatDate(date: Date): string {
    return date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}
---

<Layout
    title={catLabel}
    description={catDescription}
    lang={locale}
    languageLinks={languageLinks}
>
    <main>
        <div class="container">

            <div class="category-header">
                <a href="/ru/" class="label-small back-link">← Все публикации</a>
                <h1>{catLabel}</h1>
                <p class="category-description">{catDescription}</p>
                <p class="category-meta label-small">{postCountLabel}</p>
            </div>

            <PostFilters
                lang={locale}
                listId={postListId}
                authorKeys={authorKeys}
                total={posts.length}
            />

            <div class="post-list home-post-list row row-cols-1 row-cols-md-2 g-4" id={postListId}>
                {
                    postsWithReadingTime.map(({ post, minutesRead }) => {
                        const slug = getSlug(post.id);

                        return (
                            <PostCard
                                href={`/ru/${category}/${slug}/`}
                                title={post.data.title}
                                description={post.data.description}
                                cover={post.data.cover}
                                categoryLabel={catLabel}
                                part={post.data.part}
                                partLabel={post.data.part ? `${post.data.part}-часть` : undefined}
                                date={formatDate(post.data.date)}
                                dateTime={post.data.date.getTime()}
                                minutesRead={minutesRead}
                                locale={locale}
                                readLabel="Читать"
                                authorKey={post.data.author}
                            />
                        );
                    })
                }
            </div>

        </div>
    </main>
</Layout>
