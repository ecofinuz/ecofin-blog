---
import type { AuthorKey } from "@data/authors";
import { authors, getAuthor } from "@data/authors";
import { getCategoryDetailsFromSlug } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import AuthorSocialLinks from "@components/AuthorSocialLinks.astro";
import BylineAuthor from "@components/BylineAuthor.astro";
import PostDate from "@components/PostDate.astro";
import PostCover from "@components/PostCover.astro";
import ReadingTime from "@components/ReadingTime.astro";
import { getLocalizedAuthorLinks } from "@utils/languageLinks";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "en";

export async function getStaticPaths() {
    return (Object.keys(authors) as AuthorKey[]).map((key) => ({
        params: { author: key },
        props: { authorKey: key },
    }));
}

const { authorKey } = Astro.props;
const author = getAuthor(authorKey);
const languageLinks = getLocalizedAuthorLinks(authorKey);

const allPosts = await getCollection("blog", ({ id, data }) =>
    id.startsWith(`${locale}/`) && data.author === authorKey
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

function getSlug(id: string): string {
    return id.split("/").pop()!;
}

function getCatSlug(id: string): string {
    return getCategoryDetailsFromSlug(id.split("/")[1], locale).slug;
}

function getCatLabel(id: string): string {
    return getCategoryDetailsFromSlug(id.split("/")[1], locale).label;
}
---

<Layout title={author.name} description={author.bio[locale]} lang={locale} languageLinks={languageLinks}>
    <main>
        <div class="container">

            <div class="author-profile">
                <img
                    src={author.avatar}
                    alt={author.name}
                    class="author-avatar"
                    width="96"
                    height="96"
                />
                <div class="author-info">
                    <h1 class="author-name">{author.name}</h1>
                    <p class="author-bio">{author.bio[locale]}</p>
                    <AuthorSocialLinks
                        authorName={author.name}
                        links={author.links}
                    />
                </div>
            </div>

            <div class="author-posts">
                <p class="label-small">{posts.length} posts</p>
                <div class="post-list">
                    {postsWithReadingTime.map(({ post, minutesRead }) => (
                        <a
                            href={`/en/${getCatSlug(post.id)}/${getSlug(post.id)}/`}
                            class="post-item"
                        >
                            <PostCover
                                cover={post.data.cover}
                                title={post.data.title}
                                className="post-item-cover"
                                decorative
                            />
                            <div class="post-meta-row">
                                <span class="post-category label-small">
                                    {getCatLabel(post.id)}
                                </span>
                                {post.data.part && (
                                    <>
                                        <span class="label-small">
                                            &middot;
                                        </span>
                                        <span class="label-small post-date">
                                            Post {post.data.part}
                                        </span>
                                    </>
                                )}
                            </div>
                            <h2 class="post-title">{post.data.title}</h2>
                            <p class="post-excerpt">{post.data.description}</p>
                            <div class="post-footer">
                                <span class="post-read">Read &rarr;</span>
                                
                                <div class="post-item-byline">
                                    <BylineAuthor name={author.name} />
                                    <span class="sep">&middot;</span>
                                    <PostDate date={formatDate(post.data.date)} />
                                    <span class="sep">&middot;</span>
                                    <ReadingTime locale={locale} minutesRead={minutesRead} />
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

        </div>
    </main>
</Layout>
