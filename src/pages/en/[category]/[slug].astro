---
import type { AuthorKey } from "@data/authors";
import { getAuthor } from "@data/authors";
import { getCategoryDetailsFromSlug } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import PostCover from "@components/PostCover.astro";
import SeriesNavigation from "@components/SeriesNavigation.astro";
import { getSeriesNavigation } from "@utils/seriesNavigation";
import { getCollection, render } from "astro:content";

const locale = "en";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ id }) =>
        id.startsWith("en/")
    );

    return posts.map((post) => {
        const parts = post.id.split("/");
        const category = parts[1];
        const slug = parts[2];

        const cat = getCategoryDetailsFromSlug(category, "en");

        return {
            params: { category: cat.slug, slug },
            props: { post, seriesNavigation: getSeriesNavigation(post, posts) },
        };
    });
}

const { post, seriesNavigation } = Astro.props;
const { Content } = await render(post);
const author = getAuthor(post.data.author as AuthorKey);
const translatorKey = post.data.translated_by as AuthorKey | undefined;
const translator = translatorKey ? getAuthor(translatorKey) : undefined;
const translatorName = post.data.translated_by
    ? (translator?.name ?? post.data.translated_by)
    : undefined;
const translatorHref = translator ? `/en/author/${translatorKey}/` : undefined;

const parts = post.id.split("/");
const cat = getCategoryDetailsFromSlug(parts[1], locale);
const catLabel = cat.label;
const catSlug = cat.slug;
const ogImage = post.data.cover
    ? new URL(`/images/covers/${post.data.cover}`, Astro.site).href
    : undefined;

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}
---

<Layout title={post.data.title} description={post.data.description} lang={locale} ogImage={ogImage}>
    <main>
        <div class="container">

            <div class="post-header">
                <div class="post-meta-row">
                    <a href={`/en/${catSlug}/`} class="post-category label-small">
                        {catLabel}
                    </a>
                    {post.data.part && (
                        <>
                            <span class="label-small">
                                &middot;
                            </span>
                            <span class="label-small post-date">
                                Part {post.data.part}
                            </span>
                        </>
                    )}
                </div>
                <h1>{post.data.title}</h1>
                <p class="post-description">{post.data.description}</p>
                <div class="post-byline">
                    <a href={`/en/author/${post.data.author}/`} class="label-small byline-author">
                        {author.name}
                    </a>
                    <span class="label-small">
                        &middot;
                    </span>
                    <span class="label-small post-date">
                        {formatDate(post.data.date)}
                    </span>
                    {translatorName && (
                        <>
                            <span class="label-small">
                                &middot;
                            </span>
                            {translatorHref ? (
                                <a href={translatorHref} class="label-small byline-author">
                                    Translated by {translatorName}
                                </a>
                            ) : (
                                <span class="label-small post-date">
                                    Translated by {translatorName}
                                </span>
                            )}
                        </>
                    )}
                </div>
                <PostCover
                    cover={post.data.cover}
                    title={post.data.title}
                    className="post-hero-cover"
                    loading="eager"
                />
            </div>

            <article class="post-body">
                <Content />
                <SeriesNavigation
                    locale={locale}
                    previousPost={seriesNavigation.previousPost}
                    nextPost={seriesNavigation.nextPost}
                />
            </article>

        </div>
    </main>
</Layout>
