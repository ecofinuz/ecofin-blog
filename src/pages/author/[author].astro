---
import type { AuthorKey } from "@data/authors";
import { authors, getAuthor } from "@data/authors";
import { getCategoryDetailsFromSlug } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import AuthorStructuredData from "@components/AuthorStructuredData.astro";
import AuthorSocialLinks from "@components/AuthorSocialLinks.astro";
import PostDate from "@components/PostDate.astro";
import PostCover from "@components/PostCover.astro";
import PostFilters from "@components/PostFilters.astro";
import ReadingTime from "@components/ReadingTime.astro";
import { getLocalizedAuthorLinks } from "@utils/languageLinks";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "uz";

export async function getStaticPaths() {
    return (Object.keys(authors) as AuthorKey[]).map((key) => ({
        params: { author: key },
        props: { authorKey: key },
    }));
}

const { author: authorParam } = Astro.params;
const { authorKey } = Astro.props;
const author = getAuthor(authorKey);
const languageLinks = getLocalizedAuthorLinks(authorKey);

const allPosts = await getCollection("blog", ({ id, data }) =>
    id.startsWith(`${locale}/`) &&
    data.author === authorKey &&
    data.author === authorParam
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);
const postListId = `${locale}-${authorKey}-author-post-list`;

function formatDate(date: Date): string {
    return date.toLocaleDateString("uz-UZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

function getSlug(id: string): string {
    return id.split("/").pop()!;
}

function getCatSlug(id: string): string {
    return getCategoryDetailsFromSlug(id.split("/")[1], locale).slug;
}

function getCatLabel(id: string): string {
    return getCategoryDetailsFromSlug(id.split("/")[1], locale).label;
}
---

<Layout title={author.name} description={author.bio[locale]} lang={locale} languageLinks={languageLinks}>
    <AuthorStructuredData
        slot="head"
        author={author}
        locale={locale}
        authorHref={`/author/${authorKey}/`}
    />
    <main>
        <div class="container">

            <div class="author-profile">
                <img
                    src={author.avatar}
                    alt={author.name}
                    class="author-avatar"
                    width="96"
                    height="96"
                />
                <div class="author-info">
                    <h1 class="author-name">{author.name}</h1>
                    <p class="author-bio">{author.bio[locale]}</p>
                    <AuthorSocialLinks
                        authorName={author.name}
                        links={author.links}
                    />
                </div>
            </div>

            <div class="author-posts">
                <p class="label-small">{posts.length} ta maqola</p>
                <PostFilters
                    lang={locale}
                    listId={postListId}
                    total={posts.length}
                    showAuthorFilter={false}
                />
                <div class="post-list home-post-list" id={postListId}>
                    {postsWithReadingTime.map(({ post, minutesRead }) => (
                        <a
                            href={`/${getCatSlug(post.id)}/${getSlug(post.id)}/`}
                            class="post-item home-post-item"
                            data-post-item="true"
                            data-post-title={post.data.title}
                            data-post-date={post.data.date.getTime()}
                            data-post-author={post.data.author}
                            data-post-search={`${post.data.title} ${post.data.description}`}
                        >
                            <PostCover
                                cover={post.data.cover}
                                title={post.data.title}
                                className="post-item-cover home-post-cover"
                                placeholderLabel={getCatLabel(post.id)}
                                placeholderTitle={post.data.title}
                                decorative
                            />
                            <div class="post-meta-row home-post-meta">
                                <span class="post-category label-small">
                                    {getCatLabel(post.id)}
                                </span>
                                {post.data.part && (
                                    <>
                                        <span class="post-meta-separator" aria-hidden="true">
                                            &middot;
                                        </span>
                                        <span class="label-small post-date home-post-part">
                                            {post.data.part}-qism
                                        </span>
                                    </>
                                )}
                            </div>
                            <h2 class="post-title">{post.data.title}</h2>
                            <p class="post-excerpt">{post.data.description}</p>
                            <div class="post-footer home-post-footer">
                                <span class="post-read">O‘qish &rarr;</span>

                                <div class="post-card-details">
                                    <PostDate date={formatDate(post.data.date)} class="label-small" />
                                    <span class="post-meta-separator" aria-hidden="true">&middot;</span>
                                    <ReadingTime
                                        locale={locale}
                                        minutesRead={minutesRead}
                                        class="label-small"
                                    />
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

        </div>
    </main>
</Layout>
