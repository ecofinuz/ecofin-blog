---
import HomeHero from "@components/HomeHero.astro";
import PostCover from "@components/PostCover.astro";
import PostDate from "@components/PostDate.astro";
import ReadingTime from "@components/ReadingTime.astro";
import type { CategoryKey } from "@data/categories";
import { categories, getCategoryDetailsFromSlug } from "@data/categories";
import Layout from "@layouts/Layout.astro";
import { getPostsWithReadingTime } from "@utils/readingTime";
import { getCollection } from "astro:content";

const locale = "uz";

// Get all Uzbek posts, sorted by date descending
const allPosts = await getCollection("blog", ({ id }) =>
    id.startsWith(`${locale}/`)
);

const posts = allPosts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const postsWithReadingTime = await getPostsWithReadingTime(posts);

function formatDate(date: Date): string {
    return date.toLocaleDateString("uz-UZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
    });
}

// Derive slug from entry id: "uz/kredit/sodda-va-murakkab-foizlar" -> "sodda-va-murakkab-foizlar"
function getSlug(id: string): string {
    const parts = id.split("/");
    return parts[parts.length - 1];
}

// Derive category slug from entry id: "uz/kredit/sodda-va-murakkab-foizlar" -> "kredit"
function getCategory(id: string): string {
    const parts = id.split("/");
    return parts[1];
}

const latestPost = posts[0];
const latestCategory = latestPost
    ? getCategoryDetailsFromSlug(getCategory(latestPost.id), locale)
    : undefined;
const latestHref = latestPost && latestCategory
    ? `/${latestCategory.slug}/${getSlug(latestPost.id)}/`
    : "#articles";
---

<Layout title="Bosh sahifa" lang={locale}>
    <main class="home-main">
        <HomeHero
            lang={locale}
            latestHref={latestHref}
            latestTitle={latestPost?.data.title}
        />

        <div class="container">

            <section class="categories-section home-section" id="topics">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Mavzular</p>
                    </div>
                </div>
                <div class="category-list">
                    {
                        (Object.keys(categories) as CategoryKey[]).map((key) => (
                            <a
                                href={`/${categories[key][locale].slug}/`}
                                class="category-tag"
                            >
                                {categories[key][locale].label}
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="posts-section home-section" id="articles">
                <div class="section-heading">
                    <div>
                        <p class="label-small">Maqolalar</p>
                        <h2 class="section-title">So‘nggi maqolalar</h2>
                    </div>
                </div>
                <div class="post-list home-post-list">
                    {
                        postsWithReadingTime.map(({ post, minutesRead }) => {
                            const cat = getCategoryDetailsFromSlug(getCategory(post.id), locale);
                            const slug = getSlug(post.id);

                            return (
                                <a
                                    href={`/${cat.slug}/${slug}/`}
                                    class="post-item home-post-item"
                                >
                                    <PostCover
                                        cover={post.data.cover}
                                        title={post.data.title}
                                        className="post-item-cover home-post-cover"
                                        placeholderLabel={cat.label}
                                        placeholderTitle={post.data.title}
                                        decorative
                                    />
                                    <div class="post-meta-row home-post-meta">
                                        <span class="post-category label-small">
                                            {cat.label}
                                        </span>
                                        {post.data.part && (
                                            <>
                                                <span class="post-meta-separator" aria-hidden="true">
                                                    &middot;
                                                </span>
                                                <span class="label-small post-date home-post-part">
                                                    {post.data.part}-qism
                                                </span>
                                            </>
                                        )}
                                    </div>
                                    <h2 class="post-title">{post.data.title}</h2>
                                    <p class="post-excerpt">
                                        {post.data.description}
                                    </p>
                                    <div class="post-footer home-post-footer">
                                        <span class="post-read">O‘qish &rarr;</span>

                                        <div class="post-card-details">
                                            <PostDate date={formatDate(post.data.date)} class="label-small" />
                                            <span class="post-meta-separator" aria-hidden="true">&middot;</span>
                                            <ReadingTime
                                                locale={locale}
                                                minutesRead={minutesRead}
                                                class="label-small"
                                            />
                                        </div>
                                    </div>
                                </a>
                            );
                        })
                    }
                </div>
            </section>

        </div>
    </main>
</Layout>
